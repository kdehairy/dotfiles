{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8082/v1",
        "apiKey": "none"
      },
      "models": {
        "GLM-4.7-Flash-UD-Q2_K_XL.gguf": {
          "name": "GLM-4.7 Flash",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  },
  "model": "llamacpp/GLM-4.7-Flash-UD-Q2_K_XL.gguf",
  "autoshare": false,
  "autoupdate": false,
  "permission": {
    "write": "ask",
		"edit": "ask",
		"read": "allow",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "find *": "allow",
      "grep *": "allow",
			"cat *": "allow",
			"head *": "allow",
			"echo *": "allow"
    }
  },
  "mcp": {
		"searxng": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-searxng"
      ],
      "enabled": true,
      "environment": {
        "SEARXNG_URL": "http://localhost:8888"
      }
    },
    "qdrant": {
      "url": "http://localhost:3001/mcp",
      "type": "remote",
      "enabled": true
    }
  },
	"agent": {
		"build": {
			"mode": "primary",
			"description": "Build agent for implementation",
			"model": "llamacpp/GLM-4.7-Flash-UD-Q2_K_XL.gguf",
			"temperature": 0.7,
			"top_p": 1.0,
			"permission": {
				"write": "ask",
				"edit": "ask"
			},
			"prompt": "{file:./prompts/build.txt}"
		},
		"planner": {
			"mode": "primary",
			"description": "Planning and analysis agent - does not make any changes",
			"model": "llamacpp/GLM-4.7-Flash-UD-Q2_K_XL.gguf",
			"temperature": 1.0,
			"top_p": 0.95,
			"permission": {
				"write": "deny",
				"edit": "deny"
			},
			"prompt": "{file:./prompts/planner.txt}"
		}
	}
}
