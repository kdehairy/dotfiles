{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "options": {
        "baseURL": "http://model.cloud.home/v1",
        "apiKey": "none"
      },
      "models": {
        "Baloza-v0.3": {
          "name": "Baloza-v0.3",
          "reasoning": true,
          "limit": {
            "context": 262144,
            "output": 65536
          },
          "attachment": true,
          "tool_call": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    }
  },
  "model": "llamacpp/Baloza-v0.3",
  "autoshare": false,
  "autoupdate": false,
  "permission": {
    "write": "ask",
		"edit": "ask",
		"read": "allow",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "find *": "allow",
      "grep *": "allow",
			"head *": "allow",
			"echo *": "allow",
			"ps *": "allow"
    }
  },
  "mcp": {
    "one-search": {
      "url": "http://onesearch.cloud.home/mcp",
      "type": "remote",
      "enabled": true
    },
    "grafana": {
      "url": "http://grafana-mcp.cloud.home/mcp",
      "type": "remote",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GRAFANA_MCP_SERVER_TOKEN}"
      }
    }
  },
	"agent": {
		"vision": {
      "mode": "subagent",
      "description": "Analyzes images, screenshots, diagrams, and schematics. Returns plain-text descriptions for use by text-only models.",
      "model": "llamacpp/Baloza-v0.3",
      "permission": { "edit": "deny", "bash": "deny" }
    }
	}
}
