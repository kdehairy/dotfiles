{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "options": {
        "baseURL": "http://model.cloud.home/v1",
        "apiKey": "none"
      },
      "models": {
        "Baloza-v0.3": {
          "name": "Baloza-v0.3",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
				"Vajwala-v0.1": {
					"name": "Vajwala-v0.1"
				}
      }
    }
  },
  "model": "llamacpp/Baloza-v0.3",
  "autoshare": false,
  "autoupdate": false,
  "permission": {
    "write": "ask",
		"edit": "ask",
		"read": "allow",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "find *": "allow",
      "grep *": "allow",
			"cat *": "allow",
			"head *": "allow",
			"echo *": "allow",
			"ps *": "allow"
    }
  },
  "mcp": {
		"searxng": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-searxng"
      ],
      "enabled": true,
      "environment": {
        "SEARXNG_URL": "http://websearch.cloud.home"
      }
    },
    "qdrant": {
      "url": "http://embedding.cloud.home/mcp",
      "type": "remote",
      "enabled": true
    }
  },
	"agent": {
		"build": {
			"mode": "primary",
			"description": "Build agent for implementation",
			"model": "llamacpp/Baloza-v0.3",
			"temperature": 0.7,
			"top_p": 1.0,
			"permission": {
				"write": "ask",
				"edit": "ask"
			},
			"prompt": "{file:./prompts/build.txt}"
		},
		"planner": {
			"mode": "primary",
			"description": "Planning and analysis agent - does not make any changes",
			"model": "llamacpp/Baloza-v0.3",
			"temperature": 1.0,
			"top_p": 0.95,
			"permission": {
				"write": "deny",
				"edit": "deny"
			},
			"prompt": "{file:./prompts/planner.txt}"
		},
		"vision": {
      "mode": "subagent",
      "description": "Analyzes images, screenshots, diagrams, and schematics. Returns plain-text descriptions for use by text-only models.",
      "model": "llamacpp/Vajwala-v0.1",
      "permission": { "edit": "deny", "bash": "deny" }
    }
	}
}
