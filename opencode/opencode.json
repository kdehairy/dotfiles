{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8082/v1",
        "apiKey": "none"
      },
      "models": {
        "GLM-4.7-Flash-UD-Q2_K_XL.gguf": {
          "name": "GLM-4.7 Flash",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  },
  "model": "llamacpp/GLM-4.7-Flash-UD-Q2_K_XL.gguf",
  "autoshare": false,
  "autoupdate": false,
  "permission": {
    "write": "ask",
    "bash": "ask"
  },
	"mode": {
		"plan": {
			"temprature": 1.0,
			"top_p": 0.95
		},
		"build": {
			"temprature": 0.7,
			"top_p": 1.0
		}
	}
}
